# Private repo (user decision 2026-11-07): track everything teammates need — incl. Claude Code workflow files,
# raw OSM data, rasters and the local LLM model (large files via Git LFS, see .gitattributes).
# Still ignored: secrets, machine-specific environments, rebuildable caches and build output.

# ---- secrets (share .env out of band; template = .env.example) ----
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---- machine-specific environments (rebuild: pip install -r requirements-pipelines.txt / npm ci) ----
.venv/
venv/
node_modules/

# ---- rebuildable caches inside local/ (D-05) ----
local/cache/
local/hf/
local/torch/
local/*.log

# ---- build output ----
frontend/dist/
.vercel/
deploy/
*.tsbuildinfo

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.egg-info/

# ---- partial downloads / logs / os / editor ----
*.part
*.partial/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json

# portable machine tools (not shared)
local/tools/gh/

# local LLM (4.7 GB): too large to push — teammates run python scripts/install_ollama.py + ollama pull
local/ollama/
local/tools/ollama/
