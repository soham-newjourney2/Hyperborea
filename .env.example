# Copy to .env (never commit .env)
# Backend
CORS_ORIGINS=http://localhost:5173
ADMIN_PASSWORD=change-me   # P15 admin login; a hosted Space refuses this default
JWT_SECRET=                # >= 32 random chars (python -c "import secrets;print(secrets.token_urlsafe(48))"); short/default -> random per-process key
EXPLAINER=template          # template | ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M   # Apache-2.0, local only
OPENAQ_API_KEY=             # optional (P11)

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api

# Deploy (P04) — keep tokens in .env only
HF_TOKEN=
HF_SPACE=                   # e.g. <hf-user>/hyperborea-api
