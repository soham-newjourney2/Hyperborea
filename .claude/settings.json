{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": true,
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(npx vercel *)",
      "Bash(vercel *)",
      "Bash(hf upload *)",
